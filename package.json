{
	"name": "@local/dsh-split",
	"version": "0.1.0",
	"description": "Split-screen sessions for DeepSeek Harness: several conversations side by side in one client.",
	"private": true,
	"type": "module",
	"license": "MIT",
	"exports": {
		".": "./dist/index.js",
		"./client": "./dist/client.js",
		"./locale/*.json": "./locale/*.json",
		"./icon": "./icons/split.svg"
	},
	"files": [
		"dist",
		"locale",
		"icons",
		"cordis.patch.yml",
		"README.md",
		"LICENSE",
		"NOTICE"
	],
	"scripts": {
		"build": "bun build.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/rail-ui/tsconfig.json",
		"test": "bun test",
		"lint": "biome check ."
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web",
			"immediately": true,
			"inject": [
				"@deepseek-ai/dsh-client-ui-conversation"
			]
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@happy-dom/global-registrator": "21.0.3",
		"@rail/ui": "workspace:*",
		"@testing-library/react": "16.3.3",
		"@types/bun": "1.4.3",
		"@types/node": "26.6.5",
		"@types/react": "18.3.28",
		"@types/react-dom": "18.3.7",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"typescript": "7.0.2"
	},
	"workspaces": [
		"packages/*"
	],
	"packageManager": "bun@1.4.2"
}
